{
  // Tailwind 4 puts its own at-rules in the stylesheet - @theme, @custom-variant,
  // @apply. The editor's built-in CSS language server does not know them and
  // marks each one as an unknown rule. They are valid; the warning is not.
  "css.lint.unknownAtRules": "ignore",

  // Use the workspace's TypeScript, not the one bundled with the editor. The
  // app compiles with 6.x while the repo root still has 5.x, and the two
  // disagree about defaults - which is what put red marks on working code.
  "typescript.tsdk": "apps/web/node_modules/typescript/lib",

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "js/ts.tsdk.path": "apps/web/node_modules/typescript/lib"
}
